{
  "name": "Booking",
  "type": "object",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "ID des gebuchten Kurses"
    },
    "course_title": {
      "type": "string",
      "description": "Titel des Kurses (f\u00fcr schnellen Zugriff)"
    },
    "user_email": {
      "type": "string",
      "description": "E-Mail des Buchenden"
    },
    "user_name": {
      "type": "string",
      "description": "Name des Buchenden"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled",
        "pending"
      ],
      "default": "confirmed",
      "description": "Buchungsstatus"
    },
    "notes": {
      "type": "string",
      "description": "Anmerkungen zur Buchung"
    },
    "price_paid": {
      "type": "number",
      "description": "Gezahlter Preis"
    }
  },
  "required": [
    "course_id",
    "course_title",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}