{
  "name": "MonthlyStatSnapshot",
  "type": "object",
  "properties": {
    "month_label": {
      "type": "string",
      "description": "Bezeichnung des Monats z.B. 'Mai 2026'"
    },
    "total_courses": {
      "type": "number",
      "description": "Anzahl Kurse in diesem Monat"
    },
    "total_participants": {
      "type": "number",
      "description": "Anzahl Teilnehmende in diesem Monat"
    },
    "total_bookings": {
      "type": "number",
      "description": "Anzahl best\u00e4tigte Buchungen in diesem Monat"
    },
    "tutor_data": {
      "type": "string",
      "description": "JSON-String mit Tutor-Daten des Monats"
    },
    "course_data": {
      "type": "string",
      "description": "JSON-String mit einzelnen Kurs-Daten des Monats"
    },
    "reset_date": {
      "type": "string",
      "format": "date",
      "description": "Datum des Resets"
    }
  },
  "required": [
    "month_label"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}